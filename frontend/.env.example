# API mode: "mock" (default, fully in-browser demo server) or "http" (real backend at VITE_API_BASE)
# Use "http" to search any EDGAR filer and audit a specific 10-K accession.
VITE_API_MODE=mock

# Base URL of the real TRACE backend (FastAPI). Only used when VITE_API_MODE=http
VITE_API_BASE=http://127.0.0.1:8000
