# PS-01 uses exactly two LLM providers.
# Copy this file to .env and fill in both keys.

GEMINI_API_KEY=
GROQ_API_KEY=

# Optional model overrides. Defaults target the currently available models.
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b

# Optional Groq OpenAI-compatible API override.
# The public marketing domain (https://groq.com) is not an API endpoint.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Structured extraction is a short table lookup: 0 disables Gemini's extended
# reasoning and keeps a full audit near 10-15 seconds instead of ~25.
# GEMINI_THINKING_BUDGET=0

# SEC fair access. The SEC requires a descriptive User-Agent with contact
# details for every request.
SEC_USER_AGENT=MineArenaAuditor team@bietdavangere.edu
SEC_REQUEST_DELAY=0.2

# Runtime state (created automatically if missing).
# AUDITOR_DB_PATH=data/auditor.db
# AUDITOR_CHECKPOINT_DB=data/checkpoints.db

# Demo controls.
# DEMO_RESET_ENABLED=true    # POST /demo/reset re-seeds the demo threads
# DEMO_TAMPER_ENABLED=false   # POST /demo/tamper breaks the hash chain on purpose
# DEMO_FAILURE_MODE=false     # POST /demo/failure-mode forces new audits to fail
